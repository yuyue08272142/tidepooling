.photos {
  display: flex;
  flex-wrap: wrap;
}

.photo-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
}

.photo {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 30rpx;
}

.photo-add {
  border: 2rpx dashed #c0c4cc;
  border-radius: 12rpx;
  box-sizing: border-box;
  text-align: center;
  line-height: 176rpx;
  font-size: 64rpx;
  color: #c0c4cc;
}

.textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 30rpx;
}

.custom-tag {
  margin-top: 12rpx;
}

.custom-tag .mini-btn {
  margin-left: 16rpx;
}
