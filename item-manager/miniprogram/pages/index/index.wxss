.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.group-card {
  box-sizing: border-box;
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}

.group-name {
  font-size: 32rpx;
  font-weight: 600;
}

.group-count {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.count-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary);
  margin-right: 4rpx;
}

.reminder-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.placeholder-cover {
  background: #f0f1f3;
  text-align: center;
  line-height: 88rpx;
  font-size: 40rpx;
}

.reminder-text {
  font-size: 26rpx;
  margin-top: 8rpx;
}
