.photos {
  height: 520rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.photo {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.head-tags {
  margin-top: 16rpx;
}

.note {
  margin-top: 12rpx;
  color: #50555c;
  font-size: 28rpx;
  white-space: pre-wrap;
}

.prediction {
  font-size: 34rpx;
  font-weight: 600;
}

.basis {
  margin-top: 8rpx;
}

.subscribe {
  margin-top: 24rpx;
}

.section-head {
  margin: 8rpx 8rpx 0 0;
}

.no {
  font-weight: 600;
  margin-right: 14rpx;
}

.status {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.status-stock { background: #eef3ff; color: #3370ff; }
.status-using { background: #e8f8ef; color: var(--primary); }
.status-finished { background: #f0f1f3; color: var(--muted); }

.inst-note {
  font-size: 28rpx;
}

.detail {
  margin-top: 8rpx;
}

.instance .mini-btn {
  margin-left: 16rpx;
}

.empty-instances {
  text-align: center;
  padding: 40rpx;
}
